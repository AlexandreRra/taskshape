{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "runSubagent",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/launch.sh\" pretooluse.ts",
            "bash": "p=$(cat); case \"$p\" in *runSubagent*) printf '%s' \"$p\" | sh \"${CLAUDE_PLUGIN_ROOT}/hooks/launch.sh\" pretooluse.ts;; esac",
            "powershell": "$p = [Console]::In.ReadToEnd(); if ($p -match 'runSubagent') { $p | & (Join-Path $env:CLAUDE_PLUGIN_ROOT 'hooks/launch.ps1') pretooluse.ts }",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/launch.sh\" sessionstart.ts",
            "bash": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/launch.sh\" sessionstart.ts",
            "powershell": "& (Join-Path $env:CLAUDE_PLUGIN_ROOT 'hooks/launch.ps1') sessionstart.ts",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/launch.sh\" subagentstop.ts",
            "bash": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/launch.sh\" subagentstop.ts",
            "powershell": "& (Join-Path $env:CLAUDE_PLUGIN_ROOT 'hooks/launch.ps1') subagentstop.ts",
            "timeout": 15
          }
        ]
      }
    ]
  }
}

{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "bash": "sh hooks/launch.sh sessionstart.ts",
        "powershell": "& .\\hooks\\launch.ps1 sessionstart.ts",
        "timeoutSec": 10
      }
    ],
    "preToolUse": [
      {
        "type": "command",
        "bash": "sh hooks/launch.sh pretooluse.ts",
        "powershell": "& .\\hooks\\launch.ps1 pretooluse.ts",
        "matcher": "^task$",
        "timeoutSec": 30
      }
    ],
    "subagentStop": [
      {
        "type": "command",
        "bash": "sh hooks/launch.sh subagentstop.ts",
        "powershell": "& .\\hooks\\launch.ps1 subagentstop.ts",
        "timeoutSec": 15
      }
    ]
  }
}
